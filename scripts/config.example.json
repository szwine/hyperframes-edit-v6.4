{
  "resolution": [1080, 1920],
  "show_caption": true,
  "caption_top": "9%",
  "colors": {
    "primary": "#00f0ff",
    "magenta": "#ff4dff",
    "green": "#39ff14",
    "amber": "#ffcc00",
    "text": "#ffffff"
  },
  "corner_badge": {
    "enabled": true,
    "corner": "tr",
    "glyph": "bolt",
